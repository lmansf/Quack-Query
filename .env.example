# Server-side only; never shipped to the browser.
# Copy this file to .env for local development. On Vercel, set these as project environment variables.

# Which LLM provider api/query.ts should use: "groq" or "anthropic".
# Optional: when unset, Groq is used if GROQ_API_KEY is set, otherwise Anthropic.
LLM_PROVIDER=groq

# Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional model override (default: openai/gpt-oss-120b).
# List the models your key can use at GET /api/query?models=1 on a running deployment.
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (used when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
